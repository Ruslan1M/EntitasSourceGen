<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
    <PackageReference Include="Verify.NUnit" Version="28.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verify snapshots are data, not code. -->
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntitasSourceGen.Generator\EntitasSourceGen.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Entitas 1.14.1 runtime: generated code is compiled against it. -->
    <None Include="..\..\Package\Runtime\Plugins\Entitas\*.dll" Link="Entitas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Attribute sources are compiled into each test compilation (single source of truth). -->
    <None Include="..\..\Package\Runtime\Attributes\*.cs" Link="Attributes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
